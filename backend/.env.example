# Copy to .env and adjust. Every value is optional in development.

PORT=4000
HOST=0.0.0.0
DB_PATH=./data/cake-kitchen.db

# Comma-separated frontend origins. "*" is allowed in dev only.
CORS_ORIGINS=*
# Set to true behind a reverse proxy (Render, Fly, nginx) so rate limits see real client IPs.
TRUST_PROXY=false

# AI suggestions. Without a key the API uses rule-based house recipes.
# Groq has a free tier (key: https://console.groq.com/keys) and is used when GROQ_API_KEY is set;
# otherwise Claude is used if ANTHROPIC_API_KEY is set.
# GROQ_MODEL must support strict JSON schema: openai/gpt-oss-120b or openai/gpt-oss-20b.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_TIMEOUT_MS=20000

# Bakery dashboard keys. In development these default to dev-admin-key / dev-bakery-s1 ...
# In production (NODE_ENV=production) they are required and must be 24+ characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_KEY=
BAKERY_KEYS=s1:replace-me,s2:replace-me,s3:replace-me
